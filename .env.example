# Directory where workspace/ lives. Defaults to <repo root>/workspace when unset.
# WIKI_WORKSPACE_DIR=

# SQLite is the default. Use filesystem to open a library in the legacy format.
# PERSISTENCE_DRIVER=sqlite
# PERSISTENCE_DRIVER=filesystem

# Optional SQLite file. Defaults to <WIKI_WORKSPACE_DIR>/canon-codex.sqlite.
# SQLITE_DATABASE_PATH=

# Optional tldraw license key for Quadros and Cenas. Without it the canvas only works on
# localhost (with watermark); other hosts hide it after 5 s. See docs/research/tldraw-license.md.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
